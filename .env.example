# Copy to ".env" and fill in. The real .env is git-ignored.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Fast + cheap by default; bump to a stronger model for harder reasoning.
MODEL=claude-haiku-4-5

# Free neural voice (used when ElevenLabs is not set). Female options:
# en-US-AriaNeural · en-US-JennyNeural · en-US-MichelleNeural · en-US-EmmaNeural
JARVIS_VOICE=en-US-AriaNeural

# --- Optional: mic + speech-to-text tuning (helps if listening is flaky) ---
# Pick a specific mic (a USB mic/headset beats a laptop mic). List: python jarvis.py --mics
MIC_DEVICE=
# STT accuracy: small (default) · small.en (better English) · medium (best, slower)
WHISPER_MODEL=small

# --- Optional: premium human-level voice (ElevenLabs) ---
# Leave blank to use the free neural voice above. To enable:
#   1. Sign up at elevenlabs.io (free tier), copy your API key (Profile -> API Keys).
#   2. Open the Voice Library, preview voices, copy the Voice ID of the one you want.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=
